{
  "name": "nanoclaw-agenttrace",
  "version": "0.5.1",
  "description": "Live agent activity traces for NanoClaw — tools, tasks, reasoning summaries, and silence keepalives",
  "type": "module",
  "license": "MIT",
  "author": "Artificer Innovations, LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Artificer-Innovations/nanoclaw-agenttrace"
  },
  "homepage": "https://github.com/Artificer-Innovations/nanoclaw-agenttrace",
  "bugs": {
    "url": "https://github.com/Artificer-Innovations/nanoclaw-agenttrace/issues"
  },
  "keywords": [
    "nanoclaw",
    "ai-agent",
    "activity-trace",
    "thinking",
    "progress"
  ],
  "bin": {
    "nanoclaw-agenttrace": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "api-contract.md",
    "README.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @nanoclaw-agenttrace/shared build && pnpm --filter @nanoclaw-agenttrace/cli build && node scripts/sync-resources.mjs && node scripts/verify-publish-entry.mjs",
    "typecheck": "pnpm --filter @nanoclaw-agenttrace/shared --filter @nanoclaw-agenttrace/cli --filter @nanoclaw-agenttrace/host typecheck",
    "test:unit": "pnpm -r test:unit",
    "changeset": "changeset",
    "version": "changeset version",
    "release:publish": "npm publish --provenance --access public",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "nanoclaw-hosthooks": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "nanoclaw-hosthooks": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.4",
    "@types/node": "^22.15.30",
    "nanoclaw-hosthooks": "^0.2.0",
    "typescript": "^5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@vitest/coverage-v8": "4.1.12",
      "@vitest/mocker": "4.1.12",
      "js-yaml@>=3.0.0 <4": "3.15.2",
      "js-yaml@>=4.0.0 <5": "4.3.2",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "source-map-js": "1.2.2",
      "vite": "7.3.7",
      "vitest": "4.1.12"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
